---
import "@/styles/global.css";
import Head, {
	type Props as HeadProps,
} from "@/components/partials/Head.astro";
import "@/styles/global.css";

export interface Props extends HeadProps {
	bodyClass?: string;
}

const { bodyClass, ...props } = Astro.props;
---

<html lang="en">
	<head>
		<Head {...props} />

		<meta
	property="og:image"
	content="https://gpkashipur-pyqs.vercel.app/og.png"
/>

<meta
	property="og:title"
	content="Government Polytechnic Kashipur PYQs"
/>

<meta
	property="og:description"
	content="Previous Year Question Papers for GPK Kashipur"
/>

<meta
	property="og:type"
	content="website"
/>

<meta
	property="og:url"
	content="https://gpkashipur-pyqs.vercel.app"
/>

<meta name="description" content="Government Polytechnic Kashipur Previous Year Question Papers (PYQs) for Diploma Pharmacy, Civil, Mechanical, Electrical, CSE and other branches." />

<meta name="keywords" content="GPK Kashipur PYQ, Government Polytechnic Kashipur previous year papers, Diploma pharmacy PYQ, Uttarakhand diploma papers, GPK exam papers, Kashipur Polytechnic question papers" />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-W8MTEVEX2B"></script>
		<script>
  		window.dataLayer = window.dataLayer || [];
  		function gtag(){dataLayer.push(arguments);}
  		gtag('js', new Date());

  		gtag('config', 'G-W8MTEVEX2B');
		</script>
		<meta name="google-site-verification" content="uESZ9dE-I6BQDYXcko2FbdkriKb2VQY5VGwvvA4agL4" />
	</head>
	<body class:list={["min-h-screen", bodyClass]}>
		<slot />
	</body>
</html>
